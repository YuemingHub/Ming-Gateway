# 复制成 .env 后填入真实值：cp .env.example .env
# 本文件只列变量名，不含任何真实密钥，可以安全进版本库。
# 已存在的真实环境变量优先，不会被 .env 覆盖。

# ---- OpenCode Go（$10/月订阅，A 组渠道用）----
OPENCODE_GO_API_KEY=

# ---- 管理面登录密码（状态页 / 管理接口）----
# 用户名默认 admin。留空会导致网关拒绝启动 —— 这是故意的，防止部署后裸奔。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GATEWAY_ADMIN_PASSWORD=

# ---- 客户端令牌：调用 /v1/* 时带 Authorization: Bearer <这个值> ----
# 按组隔离：用哪个组的 key，就只会落到哪个组的渠道。
GATEWAY_TOKEN_A=
# B / C 组在 gateway.yaml 里默认是 enabled: false，等加了对应渠道再填并启用
GATEWAY_TOKEN_B=
GATEWAY_TOKEN_C=
